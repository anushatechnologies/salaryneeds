# ==============================================================================
# SalaryNeeds Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your real settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL - Supabase Shared Pooler)
# ------------------------------------------------------------------------------
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=salaryneeds
DB_USER=postgres.jbgctbgqymrdurkumwes
DB_PASSWORD=your_supabase_database_password_here

DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/salaryneeds?sslmode=require

# ------------------------------------------------------------------------------
# 2. Supabase Project Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://jbgctbgqymrdurkumwes.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Supabase Storage - S3 Configuration
# ------------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT=https://jbgctbgqymrdurkumwes.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your_supabase_storage_region_here
SUPABASE_S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id_here
SUPABASE_S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key_here

# ------------------------------------------------------------------------------
# 4. Supabase Storage Buckets
# ------------------------------------------------------------------------------
SUPABASE_CATALOG_BUCKET=catalog-images
SUPABASE_WORKER_DOCUMENTS_BUCKET=worker-documents
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images

# ------------------------------------------------------------------------------
# 5. Catalog Image Paths
# ------------------------------------------------------------------------------
SUPABASE_CATEGORY_IMAGE_PATH=categories/
SUPABASE_SUBCATEGORY_IMAGE_PATH=subcategories/
SUPABASE_VARIANT_IMAGE_PATH=variants/

# ------------------------------------------------------------------------------
# 6. Application URLs
# ------------------------------------------------------------------------------
BASE_URL=https://salary.hinchmart.com
HEALTH_CHECK_URL=https://salary.hinchmart.com/actuator/health



# ------------------------------------------------------------------------------
# 7. Application & Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 8. Logging & JPA Settings
# ------------------------------------------------------------------------------
SHOW_SQL=true
HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true

# ------------------------------------------------------------------------------
# 9. Gateway & Security (Optional)
# ------------------------------------------------------------------------------
GATEWAY_CUSTOMER_HEADER=X-Customer-Id


# ------------------------------------------------------------------------------
# 10. Application URLs
# ------------------------------------------------------------------------------
BASE_URL=https://salary.hinchmart.com
HEALTH_CHECK_URL=https://salary.hinchmart.com/actuator/health
