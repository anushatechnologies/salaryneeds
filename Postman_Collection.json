			"type": "string"
		},
		{
			"key": "addressId",
			"value": "a1111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "categoryId",
			"value": "11111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "serviceId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "workerId",
			"value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
			"type": "string"
		},
		{
			"key": "bookingId",
			"value": "1",
			"type": "string"
		}
