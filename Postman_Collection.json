						"description": "Returns full active cart details with line items, quantities, and refreshed backend prices."
					}
				},
				{
					"name": "5. Update Cart Item Quantity",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/cart/items/{{cartItemId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "items", "{{cartItemId}}"]
						}
					}
				},
				{
					"name": "6. Remove Single Service from Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/cart/items/{{cartItemId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "items", "{{cartItemId}}"]
						}
					}
				},
				{
					"name": "7. Clear Active Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/cart",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart"]
						}
					}
				},
				{
					"name": "8. Confirm Booking Checkout (Atomic Transaction)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							},
							{
								"key": "Idempotency-Key",
								"value": "CHK-ORD-9901"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"scheduledDate\": \"2026-09-25\",\n  \"scheduledTime\": \"10:00 AM - 01:00 PM\",\n  \"slotId\": \"SLOT-1013\",\n  \"notes\": \"Please call before arriving\",\n  \"idempotencyKey\": \"CHK-ORD-9901\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings/checkout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "checkout"]
						},
						"description": "Executes single atomic @Transactional checkout: validates address ownership, recalculates live backend prices, creates Booking with PENDING status, creates BookingItems, marks cart CONVERTED, and dispatches worker matching engine."
					}
				}
			]
		}
	]
}
