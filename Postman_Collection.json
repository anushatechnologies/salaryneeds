	"item": [
		{
			"name": "Domain 1: Customer Profile & Multi-Address Management",
			"item": [
				{
					"name": "1. Register Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ananya Sharma\",\n  \"email\": \"ananya.sharma@example.com\",\n  \"phone\": \"9876543299\",\n  \"password\": \"Secret@123\",\n  \"defaultAddress\": \"Flat 302, Green Meadows, Gachibowli, Hyderabad\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"]
						}
					}
				},
				{
					"name": "2. Get Paginated Customers (Admin/Support)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers?page=0&size=10&sortBy=createdAt&direction=desc",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sortBy", "value": "createdAt" },
								{ "key": "direction", "value": "desc" }
							]
						}
					}
				},
				{
					"name": "3. Get Customer by ID (With Addresses)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				},
				{
					"name": "4. Update Customer Profile",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Pavan Kumar V\",\n  \"email\": \"pavan@example.com\",\n  \"phone\": \"9876543210\",\n  \"defaultAddress\": \"Flat 402, Lotus Heights, Ayyappa Society Main Road, Madhapur, Hyderabad - 500081\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				},
				{
					"name": "5. Deactivate Customer Account",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}"]
						}
					}
				},
				{
					"name": "6. Add New Address",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"label\": \"Home\",\n  \"house\": \"Villa 12, Palm Meadows\",\n  \"street\": \"Financial District Road\",\n  \"addressLine\": \"Villa 12, Palm Meadows, Financial District Road\",\n  \"city\": \"Hyderabad\",\n  \"pincode\": \"500032\",\n  \"lat\": 17.4123,\n  \"lng\": 78.3456,\n  \"isDefault\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses"]
						}
					}
				},
				{
					"name": "7. List Saved Addresses",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses"]
						}
					}
				},
				{
					"name": "8. Get Address by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses/{{addressId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses", "{{addressId}}"]
						}
					}
				},
				{
					"name": "9. Update Address",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"label\": \"Home\",\n  \"house\": \"Flat 402-B, Lotus Heights\",\n  \"street\": \"Ayyappa Society Main Road\",\n  \"city\": \"Hyderabad\",\n  \"pincode\": \"500081\",\n  \"isDefault\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses/{{addressId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses", "{{addressId}}"]
						}
					}
				},
				{
					"name": "10. Set Default Address Explicitly",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses/{{addressId}}/default",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses", "{{addressId}}", "default"]
						}
					}
				},
				{
					"name": "11. Delete Address (With Fallback Promotion)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customers/{{customerId}}/addresses/{{addressId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "{{customerId}}", "addresses", "{{addressId}}"]
						}
					}
				}
			]
		},
		{
			"name": "Domain 2: Customer Booking, Slots & Coupon Lifecycle",
			"item": [
				{
					"name": "1. Get Dynamic Scheduling Slots",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/slots?service_id=1&date=2026-09-20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "slots"],
							"query": [
								{ "key": "service_id", "value": "1" },
								{ "key": "date", "value": "2026-09-20" }
							]
						}
					}
				},
				{
					"name": "2. Validate Promo Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"WELCOME50\",\n  \"orderAmount\": 1499.00,\n  \"serviceId\": 1,\n  \"customerId\": \"{{customerId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/coupons/validate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "coupons", "validate"]
						}
					}
				},
				{
					"name": "3. Create Service Booking",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"serviceId\": 1,\n  \"serviceName\": \"Deep Home Cleaning\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"bookingDate\": \"2026-09-20\",\n  \"slotId\": \"SLOT-0912\",\n  \"scheduledTime\": \"09:00 AM - 12:00 PM\",\n  \"totalAmount\": 1499.00,\n  \"addressId\": \"{{addressId}}\",\n  \"couponCode\": \"WELCOME50\",\n  \"notes\": \"Please bring pet-safe chemical cleaning agents.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"]
						}
					}
				},
				{
					"name": "4. Customer Booking History (Status Tab: UPCOMING)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings?status=UPCOMING&page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"],
							"query": [
								{ "key": "status", "value": "UPCOMING" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						}
					}
				},
				{
					"name": "5. View Booking Details (PIN Masked unless ARRIVED)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}"]
						}
					}
				},
				{
					"name": "6. Simulate Worker Arrival (Status -> ARRIVED)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ARRIVED\",\n  \"workerId\": \"{{workerId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}", "status"]
						}
					}
				},
				{
					"name": "7. View Booking Details After Arrival (PIN Revealed!)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}"]
						}
					}
				},
				{
					"name": "8. Verify 4-Digit Start PIN (Starts Service -> IN_PROGRESS)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pin\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}/verify-pin",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}", "verify-pin"]
						}
					}
				},
				{
					"name": "9. Regenerate Start PIN",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}/regenerate-pin",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}", "regenerate-pin"]
						}
					}
				},
				{
					"name": "10. Cancel Booking with Policy Evaluation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Customer-Id",
								"value": "{{customerId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"Need to reschedule for next week due to sudden travel\",\n  \"comments\": \"Please refund to original payment source\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "{{bookingId}}", "cancel"]
						}
					}
				}
			]
		},
		{
			"name": "Domain 3: Worker Discovery & Service Catalog",
			"item": [
				{
					"name": "1. Browse Active Categories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/catalog/categories",
							"host": ["{{baseUrl}}"],
							"path": ["api", "catalog", "categories"]
						}
					}
				},
				{
					"name": "2. List Services by Category",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/catalog/services?category_id={{categoryId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "catalog", "services"],
							"query": [
								{ "key": "category_id", "value": "{{categoryId}}" }
							]
						}
					}
				},
				{
					"name": "3. Get Single Service Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/catalog/services/{{serviceId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "catalog", "services", "{{serviceId}}"]
						}
					}
				},
				{
					"name": "4. Search Workers with Filters",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/workers/search?pincode=500081&minRating=4.5&dutyOnline=true&page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workers", "search"],
							"query": [
								{ "key": "pincode", "value": "500081" },
								{ "key": "minRating", "value": "4.5" },
								{ "key": "dutyOnline", "value": "true" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						}
					}
				},
				{
					"name": "5. Get Recommended Workers for Pincode",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/workers/recommended?pincode=500081&categoryId={{categoryId}}&limit=5",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workers", "recommended"],
							"query": [
								{ "key": "pincode", "value": "500081" },
								{ "key": "categoryId", "value": "{{categoryId}}" },
								{ "key": "limit", "value": "5" }
							]
						}
					}
				},
				{
					"name": "6. Public Worker Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/workers/{{workerId}}/profile",
							"host": ["{{baseUrl}}"],
							"path": ["api", "workers", "{{workerId}}", "profile"]
						}
					}
				}
			]
		}
	]
}
